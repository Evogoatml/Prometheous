# Prometheous environment variables
# Copy this file to .env and fill in your values

# LLM - Grok (xAI)
GROK_API_KEY=your_xai_grok_key_here
PROM_LLM_MODEL=grok-2   # or grok-2-1212, grok-beta, etc. - check your console
# or ANTHROPIC_API_KEY=...
# OLLAMA_URL=http://localhost:11434

# Telegram bot (the API key / token)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# HuggingFace (search models/datasets + finetune pulls)
HF_TOKEN=your_hf_token_here
# HUGGING_FACE_HUB_TOKEN=  # alias of HF_TOKEN

# GitHub (repo search, README, file read, code search)
GITHUB_TOKEN=ghp_xxxxxxxx
# GH_TOKEN=  # alias

# Self-growth: write researched skills into agents/ and hot-register
# PROM_SELF_GROW_INSTALL=1

# Web search (optional — DuckDuckGo works without a key)
SERPAPI_API_KEY=your_serpapi_key_here

# Shopify Admin API (optional — ads agent uses fallback products if missing)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxx
# SHOPIFY_API_VERSION=2024-10

# Meta Marketing API (optional — package always written; launch needs these)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_123456789
META_PAGE_ID=
# META_PIXEL_ID=
# ADS_AUTONOMOUS_LAUNCH=1   # required for /ads launch to call Meta (creates PAUSED)

# Optional tuning
PROM_LLM_TIMEOUT=60
PROM_SWARM_MAX_PARALLEL=16
# Max agents per mission fleet (plan → code → deploy → execute)
PROM_MISSION_MAX_AGENTS=100